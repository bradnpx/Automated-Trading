# Defaults to apps/engine/data/trade-lifecycles.json.
# TRADE_LIFECYCLE_PATH=/absolute/path/to/trade-lifecycles.json

STRATEGY_001_NAME=Strategy Display Name
STRATEGY_001_ID=CamelCaseStrategyName
